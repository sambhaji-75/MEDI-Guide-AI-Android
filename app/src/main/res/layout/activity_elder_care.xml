<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Elder Care ❤️"
            android:textColor="#172554"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Medicine, appointments and daily care"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etElderName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Elder's name"
            android:inputType="textCapWords"
            android:padding="14dp"
            android:backgroundTint="#0D9488" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="💊 Medicine Management"
            android:textColor="#172554"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Add prescribed medicines and choose a daily reminder time."
            android:textColor="#64748B"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtElderMedicines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:text="No medicines added yet."
            android:textColor="#334155"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <Button
            android:id="@+id/btnAddElderMedicine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Add Medicine + Reminder"
            android:textAllCaps="false"
            android:backgroundTint="#0D9488"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tap the medicine list to mark a dose as taken or pending."
            android:textColor="#64748B"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="🩺 Doctor Appointments"
            android:textColor="#172554"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtElderAppointments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:text="No appointments added yet."
            android:textColor="#334155"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnAddElderAppointment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Add Appointment"
            android:textAllCaps="false"
            android:backgroundTint="#7C3AED"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="❤️ Daily Care Information"
            android:textColor="#172554"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:text="💧 Hydration&#10;Offer fluids regularly, following any fluid limits advised by the doctor.&#10;&#10;🥗 Meals&#10;Provide balanced meals suited to dietary needs and medical advice.&#10;&#10;🚶 Movement&#10;Encourage comfortable movement and gentle activity when safe.&#10;&#10;🛌 Sleep and comfort&#10;Maintain a comfortable sleeping routine and a safe, uncluttered room.&#10;&#10;🧼 Hygiene&#10;Support bathing, oral care and handwashing as needed.&#10;&#10;🩺 Daily observation&#10;Notice changes in appetite, mood, mobility, pain or alertness. Seek medical advice for concerning changes."
            android:textColor="#334155"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <Button
            android:id="@+id/btnAddDailyObservation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Record Daily Observation"
            android:textAllCaps="false"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/txtDailyObservations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:text="No daily observations recorded."
            android:textColor="#334155"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="8dp"
            android:text="Follow the clinician's advice for medicines, diet, activity and fluid intake. This module does not replace medical care."
            android:textColor="#64748B"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
