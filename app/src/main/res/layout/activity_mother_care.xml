<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FC"
    android:fillViewport="true">


<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mother Care"
            android:textColor="#263653"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Pregnancy guidance and appointment tracking"
            android:textColor="#68758A"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Pregnancy Stage"
            android:textColor="#263653"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spPregnancyStage"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#C06B91" />

        <TextView
            android:id="@+id/txtStageInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FBEAF1"
            android:padding="16dp"
            android:textColor="#65384C"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Explore Mother Care"
            android:textColor="#263653"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNutrition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#438D69"
            android:text="Nutrition &amp; Healthy Eating"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnActivities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#477FC0"
            android:text="Safe Activities &amp; Exercise"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnHealth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#B85D85"
            android:text="Health &amp; Safety"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:background="#DDE2EB" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Doctor Appointment Reminder"
            android:textColor="#263653"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Save an appointment and receive a reminder on this device."
            android:textColor="#68758A"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edtDoctorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Doctor name"
            android:inputType="textCapWords"
            android:padding="14dp"
            android:backgroundTint="#C06B91" />

        <EditText
            android:id="@+id/edtClinic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Hospital / Clinic"
            android:inputType="textCapWords"
            android:padding="14dp"
            android:backgroundTint="#C06B91" />

        <Button
            android:id="@+id/btnPickDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#E8D8E0"
            android:text="Choose appointment date"
            android:textAllCaps="false"
            android:textColor="#65384C" />

        <Button
            android:id="@+id/btnPickTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#E8D8E0"
            android:text="Choose appointment time"
            android:textAllCaps="false"
            android:textColor="#65384C" />

        <EditText
            android:id="@+id/edtAppointmentNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Notes (optional)"
            android:gravity="top"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2"
            android:padding="14dp"
            android:backgroundTint="#C06B91" />

        <Button
            android:id="@+id/btnSaveAppointment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:backgroundTint="#438D69"
            android:text="Save Appointment Reminder"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Your Appointments"
            android:textColor="#263653"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtAppointmentEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="No appointments saved yet."
            android:textColor="#68758A"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/layoutAppointments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#FFF0D9"
            android:padding="14dp"
            android:text="Important: This app provides general educational information, not a medical diagnosis. Follow your healthcare professional's advice."
            android:textColor="#754D1D"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>
</ScrollView>
